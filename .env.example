# OpenAI
OPENAI_API_KEY=

# WhatsApp Cloud API (Meta App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Optional, defaults to v21.0
WHATSAPP_API_VERSION=v21.0

# Meta App Dashboard -> Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=

# Any string you choose. Must match the "Verify token" you enter when
# configuring the webhook in the Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=

# Any long random string. Required as the x-api-key header value when
# calling /conversations/:phone and /messages/:conversationId.
ADMIN_API_KEY=

# Comma-separated list of origins allowed to call this API, e.g.
# https://myapp.com,https://admin.myapp.com
# If unset, CORS allows all origins (fine for local dev only).
ALLOWED_ORIGINS=

PORT=3000

# Optional, used only by scripts/sendCheckIns.js
CHECK_IN_TEMPLATE_NAME=
CHECK_IN_INACTIVITY_DAYS=3
